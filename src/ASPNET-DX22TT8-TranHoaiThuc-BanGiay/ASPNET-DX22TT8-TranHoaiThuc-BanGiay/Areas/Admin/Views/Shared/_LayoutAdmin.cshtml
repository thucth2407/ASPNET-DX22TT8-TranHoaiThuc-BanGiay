<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="adminHMD professional admin dashboard template">
    <title>Quản Trị Admin</title>

    <link rel="stylesheet" href="~/assets/admin/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/admin/assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/assets/admin/assets/css/style.css">
</head>

<body>    
    @if (ViewData["Title"] == "Login Admin" || ViewData["Title"] == "Forgot Password" || ViewData["Title"] == "Register")
    {
        @RenderBody()        
    }
    else
    {
        <div class="admin-shell">
            <div class="sidebar-backdrop" data-sidebar-close></div>
            @await Html.PartialAsync("_SidebarAdminPartial")
            <div class="admin-main">
                @await Html.PartialAsync("_HeaderAdminPartial")
                @RenderBody()
                @await Html.PartialAsync("_FooterAdminPartial")
            </div>                
        </div>
    }            
    <script src="~/assets/admin/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/admin/assets/js/main.js"></script>
</body>
</html>
