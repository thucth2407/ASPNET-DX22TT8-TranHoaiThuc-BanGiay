@model ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.VoucherModel
@{
    ViewData["Title"] = "Edit Voucher Admin";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-ui-checks-grid" aria-hidden="true"></i>
                </span>
                <div>
                    <h1 class="h3 mb-1">Sửa mã giảm giá</h1>
                </div>
            </div>
        </div>

        <section class="row g-3">
            <div class="col-12 col-xl-12">
                <form class="panel needs-validation" novalidate asp-action="Edit" method="post">
                    <input type="hidden" class="form-control" placeholder="" id="Id" name="Id" value="@Model.Id">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label" for="formName">Mã giảm giá</label><input class="form-control" id="formName" required asp-for="Code" />
                            <div class="invalid-feedback">Mã giảm giá là bắt buộc</div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label" for="formName">Có hiệu lực tới ngày</label><input type="date" class="form-control" id="formName" required asp-for="Date" />
                            <div class="invalid-feedback">Ngày là bắt buộc</div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label" for="formName">Số tiền giảm giá</label><input type="text" class="form-control" id="formName" required asp-for="DiscountAmount" />
                            <div class="invalid-feedback">Số tiền giảm giá là bắt buộc</div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label" for="formPlan">Trạng thái</label><select class="form-select" id="formStatus" required asp-for="Status">
                                <option value="0">Tắt</option>
                                <option value="1">Bật</option>
                            </select>
                            <div class="invalid-feedback">Chọn trạng thái</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-4">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-send" aria-hidden="true"></i> Lưu
                        </button>
                        <a href="/admin/ma-giam-gia" class="btn btn-outline-secondary">Quay về</a>
                    </div>
                </form>
            </div>
        </section>
    </div>
</main>