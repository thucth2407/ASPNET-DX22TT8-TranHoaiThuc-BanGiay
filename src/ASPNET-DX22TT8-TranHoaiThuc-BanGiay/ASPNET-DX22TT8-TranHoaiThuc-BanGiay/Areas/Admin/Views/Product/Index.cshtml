@model IEnumerable<ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.ProductModel>
@{
    ViewData["Title"] = "Product Admin";
}


<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <div>
                    <h1 class="h3 mb-1">Danh sách giày</h1>
                </div>
            </div>
        </div>

        <section class="panel">
            <div class="panel-header">
                <div>
                    <a class="btn btn-primary btn-sm" href="/admin/san-pham/tao-moi">+ Thêm mới</a>
                </div>
               @*  <input class="form-control form-control-sm table-search"
                       type="search"
                       placeholder="Search orders"
                       data-table-search="ordersTable"
                       aria-label="Search orders" /> *@
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0"
                       id="ordersTable"
                       data-searchable-table>
                    <thead>
                        <tr>
                            <th>Tên giày</th>
                            <th>Loại</th>
                            <th>Số lượng</th>
                            <th>Giá tiền</th>
                            <th>Hình sản phẩm</th>
                            <th>Trạng thái</th>
                            <th></th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td><a href="/admin/san-pham/cap-nhat/@product.Id"><strong>@product.Name</strong></a></td>
                                <td>@product.Category.Name</td>
                                <td>@product.Quantity</td>
                                <td>@product.Price.ToString("#,0") đ</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <div class="table-media">
                                            <img src="@Url.Content("~/upload/product/" + @product.ImageUrl)" alt="@product.Name"
                                                 class="product-thumb"/>
                                        </div>
                                    }
                                </td>
                                <td><span class="badge text-bg-@(product.Status == 1 ? "success" : "danger")">@(product.Status == 1 ? "Bật" : "Tắt")</span></td>
                                <td>
                                    <a class="btn btn-light btn-sm" href="/admin/san-pham/cap-nhat/@product.Id">Chi tiết</a>
                                    <a class="btn btn-light btn-sm" href="@Url.Action("Delete", "Product", new { id = product.Id })">Xóa </a>
                                </td>
                            </tr>
                        }                        
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>