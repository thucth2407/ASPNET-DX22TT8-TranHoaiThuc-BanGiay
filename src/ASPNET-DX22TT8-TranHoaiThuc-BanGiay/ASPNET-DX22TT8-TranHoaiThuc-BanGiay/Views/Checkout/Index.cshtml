@using ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models
@using ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Extensions
@{
    ViewData["Title"] = "Thanh toán";
    var cart = Context.Session.GetObjectFromJson<List<CartModel>>("cart") ?? new List<CartModel>();
    decimal subTotal = cart.Sum(i => i.Price * i.Quantity);
    decimal discountAmt = ViewData["DiscountAmount"] as decimal? ?? 0m;
    string appliedCode = ViewData["AppliedCode"] as string ?? "";
    decimal total = Math.Max(0, subTotal - discountAmt);
}

<div class="breadcrumb">
    <a href="@Url.Action("Index","Home")">Trang chủ</a><span class="sep">›</span>
    <a href="@Url.Action("Index","Cart")">Giỏ hàng</a><span class="sep">›</span>
    <span style="color:var(--black)">Thanh toán</span>
</div>

<!-- STEPS -->
<div class="checkout-steps">
    <div class="step done"><span class="step-num">✓</span>Giỏ hàng</div>
    <div class="step-line"></div>
    <div class="step active"><span class="step-num">2</span>Thông tin</div>
    <div class="step-line"></div>
    <div class="step"><span class="step-num">3</span>Thanh toán</div>
</div>

<!-- MAIN LAYOUT -->
<div class="checkout-layout">

    <!-- ── FORM PANEL ── -->
    <div class="form-panel">

        <!-- BƯỚC 1 — THÔNG TIN LIÊN HỆ -->
        <div class="section-block">
            <p class="block-label">Bước 1</p>
            <h2 class="block-title">Thông tin <em>liên hệ</em></h2>

            <div class="field-row">
                <div class="field">
                    <label>Họ và tên</label>
                    <input type="text" placeholder="Nguyễn Văn A" id="inp-name">
                    <span class="error-msg" id="err-name">Vui lòng nhập họ và tên</span>
                </div>
                <div class="field">
                    <label>Địa chỉ giao hàng</label>
                    <input type="text" placeholder="Số nhà, đường, quận, thành phố" id="inp-address">
                    <span class="error-msg" id="err-address">Vui lòng nhập địa chỉ</span>
                </div>
            </div>

            <div class="field-row">
                <div class="field">
                    <label>Email</label>
                    <div class="input-group">
                        <input type="email" placeholder="email@example.com" id="inp-email">
                        <span class="input-icon" id="icon-email"></span>
                    </div>
                    <span class="error-msg" id="err-email">Địa chỉ email không hợp lệ</span>
                </div>
                <div class="field">
                    <label>Số điện thoại</label>
                    <div class="input-group">
                        <input type="tel" placeholder="0901 234 567" id="inp-phone">
                        <span class="input-icon">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.9a16 16 0 0 0 6.16 6.16l.92-.92a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                            </svg>
                        </span>
                    </div>
                    <span class="error-msg" id="err-phone">Số điện thoại không hợp lệ (10 chữ số)</span>
                </div>
            </div>
        </div>

        <hr class="block-divider">

        <!-- BƯỚC 2 — PHƯƠNG THỨC THANH TOÁN -->
        <div class="section-block">
            <p class="block-label">Bước 2</p>
            <h2 class="block-title">Phương thức <em>thanh toán</em></h2>

            <div class="payment-options">
                <div class="payment-card" id="card-cod" onclick="selectPayment('cod')">
                    <div class="radio-dot"></div>
                    <div class="payment-icon cod">🚚</div>
                    <div class="payment-info">
                        <p class="payment-name">COD</p>
                        <p class="payment-desc">Thanh toán khi nhận hàng</p>
                    </div>
                </div>

                <div class="payment-card selected" id="card-vnpay" onclick="selectPayment('vnpay')">
                    <div class="radio-dot"></div>
                    <div class="payment-icon vnpay">💳</div>
                    <div class="payment-info">
                        <p class="payment-name">VNPay</p>
                        <p class="payment-desc">Ví điện tử / QR Code</p>
                    </div>
                </div>
            </div>

            <div class="payment-note cod-note" id="note-cod" style="display:none;">
                ℹ️ Vui lòng chuẩn bị đúng số tiền khi nhận hàng.
            </div>
            <div class="payment-note vnpay-note" id="note-vnpay" style="display:flex;">
                🔒 Bạn sẽ được chuyển đến trang VNPay để hoàn tất thanh toán an toàn.
            </div>
        </div>

        <hr class="block-divider">

        <!-- AGREE & SUBMIT -->
        <div>
            <label class="check-row">
                <input type="checkbox" id="agreeTerms" checked>
                <span>Tôi đồng ý với <a href="#">Điều khoản dịch vụ</a> và <a href="#">Chính sách bảo mật</a></span>
            </label>

            <button class="btn-place-order" id="btnPlaceOrder" onclick="placeOrder()">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                Đặt hàng — <span id="btnTotal">@total.ToString("#,0")</span>₫
            </button>

            <div style="text-align:center;margin-top:8px;">
                <a href="@Url.Action("Index","Cart")" class="btn-back">← Quay lại giỏ hàng</a>
            </div>
        </div>

    </div><!-- end form-panel -->
    <!-- ── SUMMARY PANEL ── -->
    <div class="summary-panel">
        <h2 class="summary-panel-title">Đơn hàng của bạn</h2>

        <!-- Danh sách sản phẩm từ Session -->
        <div class="order-items">
            @foreach (var item in cart)
            {
                <div class="order-item">
                    <div class="order-item-img">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@Url.Content("~/upload/product/" + item.ImageUrl)"
                                 alt="@item.Name"
                                 style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />
                        }
                        else
                        {
                            <div style="width:100%;height:100%;background:#c8c4bc;border-radius:inherit;"></div>
                        }
                        <span class="item-qty-badge">@item.Quantity</span>
                    </div>
                    <div class="order-item-info">
                        <div class="order-item-name">@item.Name</div>
                        @if (!string.IsNullOrEmpty(item.Size))
                        {
                            <div class="order-item-meta">Size @item.Size</div>
                        }
                        <div class="order-item-meta">@item.Price.ToString("#,0")₫ / cái</div>
                    </div>
                    <div class="order-item-price">@item.Total.ToString("#,0")₫</div>
                </div>
            }
        </div>

        <!-- Coupon đã áp dụng từ Session -->
        @if (!string.IsNullOrEmpty(appliedCode) && discountAmt > 0)
        {
            <div class="coupon-applied" id="couponAppliedBadge">
                <span>
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                    @appliedCode — Giảm @discountAmt.ToString("#,0")₫
                </span>
            </div>
        }

        <!-- Tổng tiền -->
        <div class="sum-row">
            <span class="lbl">Tạm tính</span>
            <span class="val">@subTotal.ToString("#,0")₫</span>
        </div>

        @if (discountAmt > 0)
        {
            <div class="sum-row">
                <span class="lbl">Mã giảm giá (@appliedCode)</span>
                <span class="val discount">−@discountAmt.ToString("#,0")₫</span>
            </div>
        }

        <div class="sum-row">
            <span class="lbl">Phí vận chuyển</span>
            <span class="val free">Miễn phí</span>
        </div>
        <div class="sum-row">
            <span class="lbl">Thuế VAT (10%)</span>
            <span class="val">Đã bao gồm</span>
        </div>

        <hr class="sum-divider">

        <div class="sum-total-row">
            <span class="lbl">Tổng thanh toán</span>
            <span class="val">@total.ToString("#,0")₫</span>
        </div>
        <p class="sum-note">Đã bao gồm thuế VAT 10%</p>
    </div>

</div><!-- end checkout-layout -->
<!-- ── HIDDEN FORM (submit thật về controller) ── -->
<form id="orderForm" method="post" action="@Url.Action("Index","Checkout")" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="name" id="hd-name" />
    <input type="hidden" name="address" id="hd-address" />
    <input type="hidden" name="email" id="hd-email" />
    <input type="hidden" name="phone" id="hd-phone" />
    <input type="hidden" name="subtotal" value="@subTotal" />
    <input type="hidden" name="discount" value="@discountAmt" />
    <input type="hidden" name="total" value="@total" />
    <input type="hidden" name="paymentmethod" id="hd-paymentmethod" value="2" />
</form>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        let selectedPayment = 'vnpay';

        window.selectPayment = function(method) {
            selectedPayment = method;
            document.getElementById('card-cod').classList.toggle('selected', method === 'cod');
            document.getElementById('card-vnpay').classList.toggle('selected', method === 'vnpay');
            document.getElementById('note-cod').style.display   = method === 'cod'   ? 'flex' : 'none';
            document.getElementById('note-vnpay').style.display = method === 'vnpay' ? 'flex' : 'none';
            // 1 = COD, 2 = VNPay (khớp với controller)
            document.getElementById('hd-paymentmethod').value = method === 'cod' ? '1' : '2';
        }

        window.validateForm = function() {
            let valid = true;

            const fields = [
                { id: 'inp-name',    errId: 'err-name',    check: v => v.trim().length >= 2 },
                { id: 'inp-address', errId: 'err-address',  check: v => v.trim().length >= 5 },
                { id: 'inp-email',   errId: 'err-email',    check: v => /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(v) },
                { id: 'inp-phone',   errId: 'err-phone',    check: v => /^(0|\+84)[0-9]{9}$/.test(v.replace(/\s/g,'')) },
            ];

            fields.forEach(f => {
                const el  = document.getElementById(f.id);
                const err = document.getElementById(f.errId);

                if (!el || !err) return;

                const ok  = f.check(el.value);
                el.classList.toggle('is-invalid', !ok);
                err.style.display = ok ? 'none' : '';
                if (!ok) valid = false;
            });

            if (!document.getElementById('agreeTerms').checked) {
                alert('Vui lòng đồng ý với điều khoản dịch vụ.');
                valid = false;
            }

            return valid;
        }

        window.placeOrder = function() {
            if (!validateForm()) return;

            // Copy giá trị vào hidden form
            document.getElementById('hd-name').value    = document.getElementById('inp-name').value.trim();
            document.getElementById('hd-address').value = document.getElementById('inp-address').value.trim();
            document.getElementById('hd-email').value   = document.getElementById('inp-email').value.trim();
            document.getElementById('hd-phone').value   = document.getElementById('inp-phone').value.trim();

            // Disable nút tránh double-submit
            const btn = document.getElementById('btnPlaceOrder');
            btn.disabled = true;
            btn.innerHTML = '⏳ Đang xử lý...';

            document.getElementById('orderForm').submit();
        }

        // Real-time email validation icon
        document.getElementById('inp-email')?.addEventListener('input', function () {
            const ok   = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(this.value);
            const icon = document.getElementById('icon-email');
            this.classList.toggle('success', ok);
            icon.innerHTML = ok
                ? `<svg width="16" height="16" fill="none" stroke="#1D9E75" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>`
                : '';
        });
    });
</script>

<style>
    /* Validation states */
    .field input.is-invalid {
        border-color: #E24B4A !important;
        background: #fff8f8;
    }

    .error-msg {
        display: none;
        font-size: 12px;
        color: #E24B4A;
        margin-top: 4px;
    }
</style>
