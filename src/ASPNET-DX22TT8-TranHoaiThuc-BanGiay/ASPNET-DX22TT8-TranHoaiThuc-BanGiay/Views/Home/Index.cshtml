@model IEnumerable<ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.ProductModel>
@{
    ViewData["Title"] = "Home Page";
    var categories = ViewBag.Categories as List<ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.CategoryModel>;
    var products = ViewBag.Products as List<ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.ProductModel>;
    var newestProducts = products?.OrderByDescending(p => p.Created_at).Take(2).ToList();
    var heroProd = newestProducts?.ElementAtOrDefault(0);
    var collectionProd = newestProducts?.ElementAtOrDefault(1);
}

<!-- HERO -->
<section class="hero">
    <div class="hero-left">
        <p class="hero-badge">Bộ sưu tập Thu — Đông 2025</p>
        <h1 class="hero-title">Phong cách<br /><em>vượt thời gian</em></h1>
        <p class="hero-desc">
            Những thiết kế tối giản, tinh tế được tạo ra từ những chất liệu cao
            cấp. Thời trang không chỉ là quần áo — đó là ngôn ngữ của bạn.
        </p>
        <a href="#products" class="hero-cta">
            Khám phá ngay
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
        </a>
    </div>
    <div class="hero-right">
        <div class="hero-img-placeholder">
            @if (heroProd != null && !string.IsNullOrEmpty(heroProd.ImageUrl))
            {
                <a href="@Url.Action("Detail", "Product", new { Id = heroProd.Id })">
                    <img src="@Url.Content("~/upload/product/" + @heroProd.ImageUrl)"
                         alt="@heroProd.Name"
                         style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />
                </a>
            }
            else
            {
                <div class="silhouette"></div>
            }
        </div>
        <div class="hero-scroll">Cuộn xuống</div>
    </div>
</section>

<!-- MARQUEE -->
<div class="marquee-strip">
    <div class="marquee-inner">
        <span>Miễn phí vận chuyển toàn quốc</span><span class="dot">✦</span>
        <span>Đổi trả dễ dàng trong 30 ngày</span><span class="dot">✦</span>
        <span>Chất liệu cao cấp bền vững</span><span class="dot">✦</span>
        <span>Thiết kế độc quyền</span><span class="dot">✦</span>
        <span>Miễn phí vận chuyển toàn quốc</span><span class="dot">✦</span>
        <span>Đổi trả dễ dàng trong 30 ngày</span><span class="dot">✦</span>
        <span>Chất liệu cao cấp bền vững</span><span class="dot">✦</span>
        <span>Thiết kế độc quyền</span><span class="dot">✦</span>
    </div>
</div>

<!-- PRODUCTS -->
<section id="products">
    <div class="section-header">
        <div>
            <p class="section-label">Mới nhất</p>
            <h2 class="section-title">Sản phẩm <em>nổi bật</em></h2>
        </div>
        <a href="@Url.Action("Index", "Product")" class="view-all">Xem tất cả →</a>
    </div>

    <div class="product-grid">
        @if (products != null && products.Any())
        {
            @foreach (var product in products.Take(6))
            {
                <div class="product-card">
                    <a href="@Url.Action("Detail", "Product", new { Id = product.Id })">
                        <div class="product-img">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@Url.Content("~/upload/product/" + @product.ImageUrl)" alt="@product.Name" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="product-img-bg">
                                    <div class="product-shape" style="width:100px;height:160px;background:#c8c4bc;border-radius:60px 60px 20px 20px;"></div>
                                </div>
                            }                            
                            <div class="product-overlay">
                                <button class="add-to-cart"
                                        onclick="event.preventDefault(); addToCart(@product.Id, '@product.Name', @product.Price, 1, 1, '@product.ImageUrl')">
                                    Thêm vào giỏ
                                </button>
                            </div>
                        </div>
                        <div class="product-info">
                            <p class="product-tag">@(product.Category?.Name ?? "Sản phẩm")</p>
                            <p class="product-name">@product.Name</p>
                            <div class="product-price">
                                <span class="price-current">@product.Price.ToString("#,0")₫</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <p style="color: #888;">Chưa có sản phẩm nào.</p>
        }
    </div>
</section>

<!-- FEATURES -->
<div class="features">
    <div class="feature-item">
        <div class="feature-icon">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
        </div>
        <p class="feature-title">Miễn phí vận chuyển</p>
        <p class="feature-desc">Giao hàng toàn quốc miễn phí cho đơn từ 500.000₫</p>
    </div>
    <div class="feature-item">
        <div class="feature-icon">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M20 9V7a2 2 0 0 0-2-2h-1M20 9H4M20 9l-2 9H6L4 9m4-4H7a2 2 0 0 0-2 2v2" />
                <circle cx="9" cy="19" r="1" />
                <circle cx="15" cy="19" r="1" />
            </svg>
        </div>
        <p class="feature-title">Đổi trả 30 ngày</p>
        <p class="feature-desc">Không hài lòng? Đổi trả miễn phí trong vòng 30 ngày</p>
    </div>
    <div class="feature-item">
        <div class="feature-icon">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
        </div>
        <p class="feature-title">Thanh toán bảo mật</p>
        <p class="feature-desc">Mã hóa SSL 256-bit đảm bảo thông tin của bạn</p>
    </div>
    <div class="feature-item">
        <div class="feature-icon">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
            </svg>
        </div>
        <p class="feature-title">Chất liệu bền vững</p>
        <p class="feature-desc">100% vật liệu hữu cơ, thân thiện môi trường</p>
    </div>
</div>

@section Scripts {
    <script>
        function addToCart(id, name, price, quantity, type, imageUrl) {
            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'GET',
                data: { Id: id, Name: name, Price: price, quantity: quantity, Type: type, imageUrl: imageUrl },
                success: function (res) {
                    if (res === true) {
                        alert('Đã thêm vào giỏ hàng!');
                    }
                }
            });
        }
    </script>
}
