@model IEnumerable<ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.CartModel>
@{
    ViewData["Title"] = "Giỏ hàng";
    var cartList = Model?.ToList() ?? new List<ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.CartModel>();
    int itemCount = cartList.Count;
    decimal subTotal = cartList.Sum(i => i.Price * i.Quantity);

    // Đọc discount đã lưu trong Session (nếu có)
    var appliedCode = ViewData["AppliedCode"] as string ?? "";
    var discountAmt = ViewData["DiscountAmount"] as decimal? ?? 0m;
    decimal totalAfter = subTotal - discountAmt;
}

<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Trang chủ</a><span>›</span>
    <span style="color: var(--black)">Giỏ hàng</span>
</div>

<!-- STEPS -->
<div class="checkout-steps">
    <div class="step active"><span class="step-num">1</span>Giỏ hàng</div>
    <div class="step-line"></div>
    <div class="step"><span class="step-num">2</span>Thông tin</div>
    <div class="step-line"></div>
    <div class="step"><span class="step-num">3</span>Thanh toán</div>
</div>

<div class="page-header">
    <p class="page-label">@itemCount sản phẩm</p>
    <h1 class="page-title">Giỏ <em>hàng</em></h1>
</div>

<div class="cart-layout">
    <!-- ITEMS -->
    <div class="cart-items">
        <div class="cart-header">
            <span>Sản phẩm</span>
            <span>Đơn giá</span>
            <span>Số lượng</span>
            <span>Thành tiền</span>
        </div>

        @if (cartList.Any())
        {
            @foreach (var item in cartList)
            {
                <div class="cart-item" id="item-@item.Id">
                    <div class="item-product">
                        <div class="item-img">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@Url.Content("~/upload/product/" + item.ImageUrl)" alt="@item.Name"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <div style="width:55px;height:85px;background:#c8c4bc;border-radius:30px 30px 10px 10px;"></div>
                            }
                        </div>
                        <div class="item-details">
                            <p class="item-name">@item.Name</p>
                            @if (!string.IsNullOrEmpty(item.Size))
                            {
                                <p class="item-meta">Size: @item.Size</p>
                            }
                            <form method="post" action="@Url.Action("RemoveCart", "Cart")" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="item-remove">
                                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6l-1 14H6L5 6" />
                                        <path d="M10 11v6M14 11v6" />
                                        <path d="M9 6V4h6v2" />
                                    </svg>
                                    Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="item-price-col">
                        <span class="item-price">@item.Price.ToString("#,0")₫</span>
                    </div>
                    <div style="display:flex;justify-content:center;">
                        <form method="post" action="@Url.Action("UpdateQuantity", "Cart")" style="display:flex;align-items:center;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.Id" />
                            <div class="qty-ctrl">
                                <button type="submit" name="action" value="decrease" class="qty-btn">−</button>
                                <div class="qty-num">@item.Quantity</div>
                                <button type="submit" name="action" value="increase" class="qty-btn">+</button>
                            </div>
                        </form>
                    </div>
                    <div class="item-total-col">
                        <span class="item-total">@((item.Price * item.Quantity).ToString("#,0"))₫</span>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="text-align:center;padding:60px 0;color:var(--muted);">
                <p style="font-size:18px;margin-bottom:16px;">Giỏ hàng của bạn đang trống.</p>
                <a href="@Url.Action("Index", "Product")"
                   style="display:inline-block;padding:14px 32px;background:var(--black);color:var(--white);text-decoration:none;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;">
                    Khám phá sản phẩm
                </a>
            </div>
        }

        <div class="cart-actions">
            <a href="@Url.Action("Index", "Product")" class="continue-link">← Tiếp tục mua sắm</a>
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="cart-summary">
        <h2 class="summary-title">Tổng đơn hàng</h2>

        <div class="summary-row">
            <span class="label">Tạm tính (@itemCount sản phẩm)</span>
            <span class="value" id="subtotalDisplay">@subTotal.ToString("#,0")₫</span>
        </div>

        <!-- Vận chuyển -->
        <div style="margin:20px 0;">
            <p style="font-size:11px;letter-spacing:0.12em;text-transform:uppercase;font-weight:500;color:var(--black);margin-bottom:12px;">
                Phương thức vận chuyển
            </p>
            <div class="shipping-options">
                <label class="shipping-option active">
                    <input type="radio" name="shipping" checked />
                    <div class="shipping-info">
                        <div class="shipping-name">Giao hàng tiêu chuẩn</div>
                        <div class="shipping-desc">3–5 ngày làm việc</div>
                    </div>
                    <span class="shipping-price" style="color:var(--gold)">Miễn phí</span>
                </label>
            </div>
        </div>

        <!-- ── MÃ GIẢM GIÁ ── -->
        <p style="font-size:11px;letter-spacing:0.12em;text-transform:uppercase;font-weight:500;color:var(--black);margin-bottom:12px;">
            Mã giảm giá
        </p>

        @* Nếu chưa có coupon: hiện ô nhập *@
        <div id="couponForm" style="@(string.IsNullOrEmpty(appliedCode) ? "" : "display:none;")">
            <div class="coupon-row">
                <input type="text" id="couponInput" class="coupon-input" placeholder="Nhập mã khuyến mãi" />
                <button type="button" class="coupon-btn" onclick="applyCoupon()">Áp dụng</button>
            </div>
            <p id="couponError" style="display:none;font-size:12px;color:#E24B4A;margin-top:6px;"></p>
            <p id="couponLoading" style="display:none;font-size:12px;color:var(--muted);margin-top:6px;">Đang kiểm tra...</p>
        </div>

        @* Badge coupon đã áp dụng *@
        <div id="couponApplied"
             class="coupon-applied-badge"
             style="@(string.IsNullOrEmpty(appliedCode) ? "display:none;" : "")">
            <span class="coupon-applied-text">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
                <span id="couponCodeLabel">@appliedCode</span> — Giảm <span id="couponDiscountLabel">@discountAmt.ToString("#,0")</span>₫
            </span>
            <button type="button" class="coupon-remove-btn" onclick="removeCoupon()">✕ Xóa</button>
        </div>

        @* Dòng discount trong bảng tổng *@
        <div class="summary-row" id="discountRow" style="@(discountAmt > 0 ? "" : "display:none;")">
            <span class="label">Mã giảm giá</span>
            <span class="value" style="color:#E24B4A;">−<span id="discountDisplay">@discountAmt.ToString("#,0")</span>₫</span>
        </div>

        <hr class="summary-divider" />

        <div class="summary-total">
            <span class="label">Tổng cộng</span>
            <span class="value" id="totalDisplay">@totalAfter.ToString("#,0")₫</span>
        </div>
        <p class="summary-note">Đã bao gồm VAT. Phí vận chuyển sẽ được tính ở bước tiếp theo.</p>

        @if (cartList.Any())
        {
            <a href="@Url.Action("Index", "Checkout")" class="btn-checkout">
                Tiến hành thanh toán
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </a>
        }
        else
        {
            <button class="btn-checkout" disabled style="opacity:0.4;cursor:not-allowed;">
                Tiến hành thanh toán
            </button>
        }
        <p style="text-align:center;font-size:11px;color:var(--stone);margin-top:14px;display:flex;align-items:center;justify-content:center;gap:6px;">
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="11" width="18" height="11" rx="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            Thanh toán an toàn & bảo mật
        </p>
    </div>
</div>

<style>
    /* ── COUPON BADGE ── */
    .coupon-applied-badge {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #e8f5f0;
        border: 1px solid #a3d9c3;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 14px;
        font-size: 13px;
    }

    .coupon-applied-text {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #0F6E56;
        font-weight: 500;
    }

    .coupon-remove-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 12px;
        color: #888;
        padding: 2px 4px;
        border-radius: 4px;
        transition: color .15s, background .15s;
    }

        .coupon-remove-btn:hover {
            color: #E24B4A;
            background: #fff0f0;
        }
</style>

<script>
    // Số tạm tính gốc từ server (không đổi khi coupon thay đổi)
    const BASE_SUBTOTAL = @subTotal;

    function formatVND(amount) {
        return amount.toLocaleString('vi-VN') + '₫';
    }

    function updateTotals(discountAmount) {
        const total = Math.max(0, BASE_SUBTOTAL - discountAmount);
        document.getElementById('totalDisplay').textContent = formatVND(total);
        if (discountAmount > 0) {
            document.getElementById('discountRow').style.display = '';
            document.getElementById('discountDisplay').textContent = discountAmount.toLocaleString('vi-VN');
        } else {
            document.getElementById('discountRow').style.display = 'none';
        }
    }

    async function applyCoupon() {
        const code = document.getElementById('couponInput').value.trim();
        if (!code) return;

        const errorEl   = document.getElementById('couponError');
        const loadingEl = document.getElementById('couponLoading');
        errorEl.style.display   = 'none';
        loadingEl.style.display = '';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const res = await fetch('@Url.Action("ApplyCoupon", "Cart")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ code })
            });
            const data = await res.json();
            loadingEl.style.display = 'none';

            if (data.success) {
                // Hiện badge, ẩn form nhập
                document.getElementById('couponForm').style.display = 'none';
                document.getElementById('couponCodeLabel').textContent    = data.code;
                document.getElementById('couponDiscountLabel').textContent = data.discountAmount.toLocaleString('vi-VN');
                document.getElementById('couponApplied').style.display = '';
                updateTotals(data.discountAmount);
            } else {
                errorEl.textContent    = data.message;
                errorEl.style.display = '';
            }
        } catch (e) {
            loadingEl.style.display = 'none';
            errorEl.textContent    = 'Có lỗi xảy ra, vui lòng thử lại.';
            errorEl.style.display  = '';
        }
    }

    async function removeCoupon() {
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            await fetch('@Url.Action("RemoveCoupon", "Cart")', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
        } catch (_) {}

        // Reset UI
        document.getElementById('couponApplied').style.display  = 'none';
        document.getElementById('couponForm').style.display     = '';
        document.getElementById('couponInput').value            = '';
        updateTotals(0);
    }

    // Cho phép nhấn Enter trong ô coupon
    document.getElementById('couponInput')?.addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); applyCoupon(); }
    });
</script>

@* Token cho AJAX không-form *@
@Html.AntiForgeryToken()
