@model IEnumerable<ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.CartModel>
@{
    ViewData["Title"] = "Cart";
}
<div class="breadcrumb">
    <a href="shop-template.html">Trang chủ</a><span>›</span>
    <span style="color: var(--black)">Giỏ hàng</span>
</div>

<!-- STEPS -->
<div class="checkout-steps">
    <div class="step active"><span class="step-num">1</span>Giỏ hàng</div>
    <div class="step-line"></div>
    <div class="step"><span class="step-num">2</span>Thông tin</div>
    <div class="step-line"></div>
    <div class="step"><span class="step-num">3</span>Vận chuyển</div>
    <div class="step-line"></div>
    <div class="step"><span class="step-num">4</span>Thanh toán</div>
</div>

<div class="page-header">
    <p class="page-label">3 sản phẩm</p>
    <h1 class="page-title">Giỏ <em>hàng</em></h1>
</div>

<div class="cart-layout">
    <!-- ITEMS -->
    <div class="cart-items">
        <div class="cart-header">
            <span>Sản phẩm</span>
            <span>Đơn giá</span>
            <span>Số lượng</span>
            <span>Thành tiền</span>
        </div>

        <!-- Item 1 -->
        <div class="cart-item" id="item1">
            <div class="item-product">
                <div class="item-img">
                    <div style="
                  width: 55px;
                  height: 85px;
                  background: #c8c4bc;
                  border-radius: 30px 30px 10px 10px;
                "></div>
                </div>
                <div class="item-details">
                    <p class="item-category">Áo khoác</p>
                    <p class="item-name">Cashmere Trench Coat</p>
                    <p class="item-meta">Màu: Camel Stone · Size: M</p>
                    <button class="item-remove" onclick="removeItem('item1')">
                        <svg width="12"
                             height="12"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             viewBox="0 0 24 24">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6l-1 14H6L5 6" />
                            <path d="M10 11v6M14 11v6" />
                            <path d="M9 6V4h6v2" />
                        </svg>
                        Xóa
                    </button>
                </div>
            </div>
            <div class="item-price-col">
                <span class="item-price">2.890.000₫</span>
            </div>
            <div style="display: flex; justify-content: center">
                <div class="qty-ctrl">
                    <button class="qty-btn" onclick="changeQty('q1', -1)">−</button>
                    <div class="qty-num" id="q1">1</div>
                    <button class="qty-btn" onclick="changeQty('q1', 1)">+</button>
                </div>
            </div>
            <div class="item-total-col">
                <span class="item-total" id="t1">2.890.000₫</span>
            </div>
        </div>

        <!-- Item 2 -->
        <div class="cart-item" id="item2">
            <div class="item-product">
                <div class="item-img">
                    <div style="
                  width: 50px;
                  height: 80px;
                  background: #b8c4b8;
                  border-radius: 8px;
                "></div>
                </div>
                <div class="item-details">
                    <p class="item-category">Váy</p>
                    <p class="item-name">Midi Slip Dress Lụa</p>
                    <p class="item-meta">Màu: Sage Green · Size: S</p>
                    <button class="item-remove" onclick="removeItem('item2')">
                        <svg width="12"
                             height="12"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             viewBox="0 0 24 24">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6l-1 14H6L5 6" />
                            <path d="M10 11v6M14 11v6" />
                            <path d="M9 6V4h6v2" />
                        </svg>
                        Xóa
                    </button>
                </div>
            </div>
            <div class="item-price-col">
                <span class="item-price">1.560.000₫</span>
                <span class="item-price-was">1.950.000₫</span>
            </div>
            <div style="display: flex; justify-content: center">
                <div class="qty-ctrl">
                    <button class="qty-btn" onclick="changeQty('q2', -1)">−</button>
                    <div class="qty-num" id="q2">1</div>
                    <button class="qty-btn" onclick="changeQty('q2', 1)">+</button>
                </div>
            </div>
            <div class="item-total-col">
                <span class="item-total" id="t2">1.560.000₫</span>
            </div>
        </div>

        <!-- Item 3 -->
        <div class="cart-item" id="item3">
            <div class="item-product">
                <div class="item-img">
                    <div style="
                  width: 45px;
                  height: 70px;
                  background: #bcbcb0;
                  border-radius: 20px;
                "></div>
                </div>
                <div class="item-details">
                    <p class="item-category">Phụ kiện</p>
                    <p class="item-name">Canvas Tote Bag</p>
                    <p class="item-meta">Màu: Natural</p>
                    <button class="item-remove" onclick="removeItem('item3')">
                        <svg width="12"
                             height="12"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             viewBox="0 0 24 24">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6l-1 14H6L5 6" />
                            <path d="M10 11v6M14 11v6" />
                            <path d="M9 6V4h6v2" />
                        </svg>
                        Xóa
                    </button>
                </div>
            </div>
            <div class="item-price-col">
                <span class="item-price">890.000₫</span>
            </div>
            <div style="display: flex; justify-content: center">
                <div class="qty-ctrl">
                    <button class="qty-btn" onclick="changeQty('q3', -1)">−</button>
                    <div class="qty-num" id="q3">1</div>
                    <button class="qty-btn" onclick="changeQty('q3', 1)">+</button>
                </div>
            </div>
            <div class="item-total-col">
                <span class="item-total" id="t3">890.000₫</span>
            </div>
        </div>

        <div class="cart-actions">
            <a href="mura-products.html" class="continue-link">← Tiếp tục mua sắm</a>
            <button class="btn-outline-sm">Cập nhật giỏ hàng</button>
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="cart-summary">
        <h2 class="summary-title">Tổng đơn hàng</h2>

        <div class="summary-row">
            <span class="label">Tạm tính (3 sản phẩm)</span>
            <span class="value" id="subtotal">5.340.000₫</span>
        </div>
        <div class="summary-row discount">
            <span class="label">Giảm giá</span>
            <span class="value">−390.000₫</span>
        </div>

        <!-- Shipping -->
        <div style="margin: 20px 0">
            <p style="
              font-size: 11px;
              letter-spacing: 0.12em;
              text-transform: uppercase;
              font-weight: 500;
              color: var(--black);
              margin-bottom: 12px;
            ">
                Phương thức vận chuyển
            </p>
            <div class="shipping-options">
                <label class="shipping-option active">
                    <input type="radio" name="shipping" checked />
                    <div class="shipping-info">
                        <div class="shipping-name">Giao hàng tiêu chuẩn</div>
                        <div class="shipping-desc">3–5 ngày làm việc</div>
                    </div>
                    <span class="shipping-price" style="color: var(--gold)">Miễn phí</span>
                </label>
                <label class="shipping-option">
                    <input type="radio" name="shipping" />
                    <div class="shipping-info">
                        <div class="shipping-name">Giao hàng nhanh</div>
                        <div class="shipping-desc">1–2 ngày làm việc</div>
                    </div>
                    <span class="shipping-price">40.000₫</span>
                </label>
                <label class="shipping-option">
                    <input type="radio" name="shipping" />
                    <div class="shipping-info">
                        <div class="shipping-name">Hỏa tốc</div>
                        <div class="shipping-desc">Trong ngày (HCM & HN)</div>
                    </div>
                    <span class="shipping-price">80.000₫</span>
                </label>
            </div>
        </div>

        <!-- Coupon -->
        <p style="
            font-size: 11px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 500;
            color: var(--black);
            margin-bottom: 12px;
          ">
            Mã giảm giá
        </p>
        <div class="coupon-row">
            <input type="text"
                   class="coupon-input"
                   placeholder="Nhập mã khuyến mãi" />
            <button class="coupon-btn">Áp dụng</button>
        </div>

        <hr class="summary-divider" />

        <div class="summary-total">
            <span class="label">Tổng cộng</span>
            <span class="value">4.950.000₫</span>
        </div>
        <p class="summary-note">
            Đã bao gồm VAT. Phí vận chuyển sẽ được tính ở bước tiếp theo.
        </p>

        <a href="mura-checkout.html" class="btn-checkout">
            Tiến hành thanh toán
            <svg width="16"
                 height="16"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5"
                 viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
        </a>

        <div style="
            text-align: center;
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 12px;
          ">
            hoặc
        </div>
        <div style="
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 16px;
          ">
            <button style="
              background: #0070ba;
              color: #fff;
              border: none;
              font-family: var(--sans);
              font-size: 13px;
              font-weight: 500;
              padding: 14px;
              cursor: pointer;
              letter-spacing: 0.03em;
            ">
                Pay Pal
            </button>
            <button style="
              background: #000;
              color: #fff;
              border: none;
              font-family: var(--sans);
              font-size: 13px;
              font-weight: 500;
              padding: 14px;
              cursor: pointer;
            ">
                Apple Pay
            </button>
        </div>

        <div class="payment-methods">
            <span class="pay-icon">VISA</span>
            <span class="pay-icon">MC</span>
            <span class="pay-icon">JCB</span>
            <span class="pay-icon">Momo</span>
            <span class="pay-icon">VNPay</span>
        </div>
        <p style="
            text-align: center;
            font-size: 11px;
            color: var(--stone);
            margin-top: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
          ">
            <svg width="12"
                 height="12"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 viewBox="0 0 24 24">
                <rect x="3" y="11" width="18" height="11" rx="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            Thanh toán an toàn & bảo mật
        </p>
    </div>
</div>

<!-- UPSELL -->
<section class="upsell-section">
    <p class="section-label">Thêm vào giỏ</p>
    <h2 class="section-title">Có thể bạn <em>muốn thêm</em></h2>
    <div class="upsell-grid">
        <div class="upsell-card">
            <div class="upsell-img" style="background: #e8e4e8">
                <div style="
                width: 80px;
                height: 140px;
                background: #c4b8c4;
                border-radius: 50% 50% 8px 8px;
              "></div>
            </div>
            <button class="upsell-add">+</button>
            <div class="upsell-info">
                <p style="
                font-size: 10px;
                color: var(--gold);
                letter-spacing: 0.15em;
                text-transform: uppercase;
                margin-bottom: 4px;
              ">
                    Áo
                </p>
                <p class="upsell-name">Linen Blazer</p>
                <p class="upsell-price">1.890.000₫</p>
            </div>
        </div>
        <div class="upsell-card">
            <div class="upsell-img" style="background: #ebe5e0">
                <div style="
                width: 85px;
                height: 140px;
                background: #c4b8ac;
                border-radius: 10px;
              "></div>
            </div>
            <button class="upsell-add">+</button>
            <div class="upsell-info">
                <p style="
                font-size: 10px;
                color: var(--gold);
                letter-spacing: 0.15em;
                text-transform: uppercase;
                margin-bottom: 4px;
              ">
                    Áo
                </p>
                <p class="upsell-name">Silk Wrap Blouse</p>
                <p class="upsell-price">1.290.000₫</p>
            </div>
        </div>
        <div class="upsell-card">
            <div class="upsell-img" style="background: #e2e6e8">
                <div style="
                width: 80px;
                height: 130px;
                background: #acb8c0;
                border-radius: 20px;
              "></div>
            </div>
            <button class="upsell-add">+</button>
            <div class="upsell-info">
                <p style="
                font-size: 10px;
                color: var(--gold);
                letter-spacing: 0.15em;
                text-transform: uppercase;
                margin-bottom: 4px;
              ">
                    Quần
                </p>
                <p class="upsell-name">Wide-Leg Trousers</p>
                <p class="upsell-price">1.615.000₫</p>
            </div>
        </div>
        <div class="upsell-card">
            <div class="upsell-img" style="background: #edeae4">
                <div style="
                width: 75px;
                height: 100px;
                background: #c8c4bc;
                border-radius: 8px;
              "></div>
            </div>
            <button class="upsell-add">+</button>
            <div class="upsell-info">
                <p style="
                font-size: 10px;
                color: var(--gold);
                letter-spacing: 0.15em;
                text-transform: uppercase;
                margin-bottom: 4px;
              ">
                    Phụ kiện
                </p>
                <p class="upsell-name">Silk Scarf</p>
                <p class="upsell-price">590.000₫</p>
            </div>
        </div>
    </div>
</section>