@{
    ViewData["Title"] = "Approve";
}
<canvas id="particle-canvas"></canvas>

<!-- HERO -->
<canvas id="confetti-canvas"></canvas>

    <!-- LEFT -->
    <div class="success-left">
        <div class="check-anim">
            <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
        </div>
        <p class="success-eyebrow">Đặt hàng thành công</p>
        <h1 class="success-title">Cảm ơn<br>bạn đã tin<br><em>tưởng MURA</em></h1>
        <p class="success-sub">Chúng tôi đã nhận được đơn hàng của bạn và đang tiến hành xử lý. Một email xác nhận đã được gửi đến địa chỉ của bạn.</p>

        <div class="order-id-box">
            <div>
                <div class="order-id-label">Mã đơn hàng</div>
                <div class="order-id-num">#MURA-2025-00847</div>
            </div>
            <button class="order-id-copy" onclick="copyOrderId()" title="Sao chép">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
            </button>
        </div>

        <div class="success-ctas">
            <a href="mura-products.html" class="btn-primary">
                Tiếp tục mua sắm
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
            </a>
            <button class="btn-outline" onclick="window.print()">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                In hóa đơn
            </button>
        </div>
    </div>

    <!-- RIGHT -->
    <div class="success-right">

        <!-- TIMELINE -->
        <div class="timeline">
            <div class="timeline-title">Trạng thái đơn hàng</div>
            <div class="timeline-steps">
                <div class="tl-step done active">
                    <div class="tl-dot done">✓</div>
                    <div class="tl-label">Đơn hàng đã xác nhận</div>
                    <div class="tl-meta">Hôm nay, 14:32 — #MURA-2025-00847</div>
                </div>
                <div class="tl-step active">
                    <div class="tl-dot active"></div>
                    <div class="tl-label">Đang đóng gói</div>
                    <div class="tl-meta">Dự kiến hoàn thành trong 24 giờ</div>
                </div>
                <div class="tl-step">
                    <div class="tl-dot"></div>
                    <div class="tl-label">Đã bàn giao vận chuyển</div>
                    <div class="tl-meta">Dự kiến ngày 21/05/2025</div>
                </div>
                <div class="tl-step">
                    <div class="tl-dot"></div>
                    <div class="tl-label">Đang giao hàng</div>
                    <div class="tl-meta">Dự kiến ngày 22–23/05/2025</div>
                </div>
                <div class="tl-step">
                    <div class="tl-dot"></div>
                    <div class="tl-label">Giao hàng thành công</div>
                    <div class="tl-meta">123 Nguyễn Huệ, Quận 1, TP.HCM</div>
                </div>
            </div>
        </div>

        <!-- ORDER SUMMARY -->
        <div class="order-summary">
            <div class="os-title">Sản phẩm đã đặt</div>

            <div class="os-item">
                <div class="os-img">
                    <div style="width:34px;height:52px;background:#c8c4bc;border-radius:18px 18px 6px 6px;"></div>
                    <span class="os-img-qty">1</span>
                </div>
                <div class="os-info">
                    <div class="os-brand">Áo khoác</div>
                    <div class="os-name">Cashmere Trench Coat</div>
                    <div class="os-meta">Camel Stone · M</div>
                </div>
                <div class="os-price">2.890.000₫</div>
            </div>

            <div class="os-item">
                <div class="os-img">
                    <div style="width:30px;height:48px;background:#b8c4b8;border-radius:6px;"></div>
                    <span class="os-img-qty">1</span>
                </div>
                <div class="os-info">
                    <div class="os-brand">Váy</div>
                    <div class="os-name">Midi Slip Dress Lụa</div>
                    <div class="os-meta">Sage Green · S</div>
                </div>
                <div class="os-price">1.560.000₫</div>
            </div>

            <div class="os-item">
                <div class="os-img">
                    <div style="width:28px;height:40px;background:#bcbcb0;border-radius:12px;"></div>
                    <span class="os-img-qty">1</span>
                </div>
                <div class="os-info">
                    <div class="os-brand">Phụ kiện</div>
                    <div class="os-name">Canvas Tote Bag</div>
                    <div class="os-meta">Natural</div>
                </div>
                <div class="os-price">890.000₫</div>
            </div>

            <div class="os-totals">
                <div class="os-row"><span class="l">Tạm tính</span><span class="v">5.340.000₫</span></div>
                <div class="os-row"><span class="l">Mã giảm giá (MURA20)</span><span class="v disc">−390.000₫</span></div>
                <div class="os-row"><span class="l">Vận chuyển</span><span class="v" style="color:var(--success)">Miễn phí</span></div>
                <div class="os-row total"><span class="l">Tổng đã thanh toán</span><span class="v">4.950.000₫</span></div>
            </div>
        </div>

        <!-- DELIVERY INFO -->
        <div class="delivery-info">
            <div class="di-icon">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" /><polygon points="16 8 20 8 23 11 23 16 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
            </div>
            <div>
                <div class="di-title">Giao tới: Nguyễn Minh Anh</div>
                <div class="di-text">123 Nguyễn Huệ, P. Bến Nghé, Quận 1, TP. Hồ Chí Minh<br>SĐT: 0901 234 567 · Dự kiến: <strong>22–23 tháng 5, 2025</strong></div>
            </div>
        </div>

        <!-- SHARE -->
        <div class="share-section">
            <div class="share-title">Chia sẻ niềm vui</div>
            <div class="share-btns">
                <button class="share-btn">Facebook</button>
                <button class="share-btn">Instagram</button>
                <button class="share-btn">Zalo</button>
                <button class="share-btn">Copy link</button>
            </div>
        </div>

    </div>
</div>

<!-- RECOMMENDATIONS -->
<section class="recs-section">
    <p class="recs-eyebrow">Có thể bạn thích</p>
    <h2 class="recs-title">Mua thêm <em>cho trọn bộ</em></h2>
    <div class="recs-grid">
        <div class="rec-card">
            <div class="rec-img" style="background:#e8e4e8;"><div style="width:80px;height:140px;background:#c4b8c4;border-radius:50% 50% 8px 8px;"></div></div>
            <div class="rec-info"><div class="rec-tag">Áo</div><div class="rec-name">Linen Blazer</div><div class="rec-price">1.890.000₫</div></div>
        </div>
        <div class="rec-card">
            <div class="rec-img" style="background:#ebe5e0;"><div style="width:85px;height:140px;background:#c4b8ac;border-radius:10px;"></div></div>
            <div class="rec-info"><div class="rec-tag">Áo</div><div class="rec-name">Silk Wrap Blouse</div><div class="rec-price">1.290.000₫</div></div>
        </div>
        <div class="rec-card">
            <div class="rec-img" style="background:#e2e6e8;"><div style="width:80px;height:130px;background:#acb8c0;border-radius:20px;"></div></div>
            <div class="rec-info"><div class="rec-tag">Quần</div><div class="rec-name">Wide-Leg Trousers</div><div class="rec-price">1.615.000₫</div></div>
        </div>
        <div class="rec-card">
            <div class="rec-img" style="background:#edeae4;"><div style="width:75px;height:100px;background:#c8c4bc;border-radius:8px;"></div></div>
            <div class="rec-info"><div class="rec-tag">Phụ kiện</div><div class="rec-name">Silk Scarf</div><div class="rec-price">590.000₫</div></div>
        </div>
    </div>
</section>