@model ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.ProductModel
@{
    ViewData["Title"] = Model?.Name ?? "Chi tiết sản phẩm";
    var related = ViewBag.Related as List<ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.ProductModel>;
}

<!-- BREADCRUMB -->
<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
    <span>›</span>
    <a href="@Url.Action("Index", "Product")">Bộ sưu tập</a>
    <span>›</span>
    @if (Model?.Category != null)
    {
        <a href="@Url.Action("Index", "Product", new { category = Model.Category.Slug })">@Model.Category.Name</a>
        <span>›</span>
    }
    <span style="color:var(--black)">@Model?.Name</span>
</div>

<!-- PRODUCT DETAIL -->
<div class="product-detail">

    <!-- GALLERY (trái) -->
    <div class="gallery">
        <div></div>
        <div class="gallery-main">
            @if (!string.IsNullOrEmpty(Model?.ImageUrl))
            {
                <img id="mainImage" src="@Url.Content("~/upload/product/" + @Model.ImageUrl)" alt="@Model.Name"
                     style="width:100%;height:100%;object-fit:cover;" />
            }
            else
            {
                <div class="main-img">
                    <div style="width:160px;height:280px;background:#c8c4bc;border-radius:80px;"></div>
                </div>
            }            
        </div>
    </div>

    <!-- PRODUCT INFO PANEL (phải) -->
    <div class="product-info-panel">

        <p class="product-brand">@(Model?.Category?.Name ?? "MURA")</p>
        <h1 class="product-title">@Model?.Name</h1>
        <p class="product-sub">@Model?.Description</p>

        <!-- GIÁ -->
        <div class="price-section">
            <span class="price-main">@Model?.Price.ToString("#,0")₫</span>
        </div>     

        <!-- SỐ LƯỢNG -->
        <div class="option-label">Số lượng <span style="font-size:11px;color:var(--muted);font-weight:400;text-transform:none;letter-spacing:0;">Còn @Model?.Quantity sản phẩm</span></div>
        <div class="qty-row">
            <button class="qty-btn" onclick="changeQty(-1)">−</button>
            <input class="qty-input" id="qtyDisplay" type="text" value="1" readonly />
            <button class="qty-btn" onclick="changeQty(1)">+</button>
        </div>

        <!-- CTA -->
        <div class="cta-row">
            <button class="btn-primary" onclick="handleAddToCart()">Thêm vào giỏ hàng</button>            
        </div>

        <!-- SHIPPING NOTE -->
        <div class="shipping-note">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
            Miễn phí vận chuyển cho đơn từ 500.000₫ — Đổi trả 30 ngày
        </div>

        <!-- TABS: Mô tả / Chi tiết -->
        <div class="tabs">
            <div class="tab-nav">
                <button class="tab-btn active" onclick="switchTab(this, 'tab-desc')">Mô tả</button>
                <button class="tab-btn" onclick="switchTab(this, 'tab-spec')">Thông số</button>
            </div>
            <div class="tab-content active" id="tab-desc">
                @if (!string.IsNullOrEmpty(Model?.Content))
                {
                    <p>@Html.Raw(Model.Content)</p>
                }
                else
                {
                    <p>@Model?.Description</p>
                }
            </div>
            <div class="tab-content" id="tab-spec">
                <table class="spec-table">
                    <tr><td>Danh mục</td><td>@(Model?.Category?.Name ?? "—")</td></tr>
                    <tr><td>Trạng thái</td><td>@(Model?.Status == 1 ? "Còn hàng" : "Ngừng kinh doanh")</td></tr>
                    <tr><td>Tồn kho</td><td>@Model?.Quantity sản phẩm</td></tr>
                    <tr><td>Cập nhật</td><td>@Model?.Updated_at.ToString("dd/MM/yyyy")</td></tr>
                </table>
            </div>
        </div>

    </div>
</div>

<!-- SẢN PHẨM LIÊN QUAN -->
@if (related != null && related.Any())
{
    <div class="related">
        <p class="section-label">Gợi ý</p>
        <h2 class="section-title">Sản phẩm <em>liên quan</em></h2>
        <div class="related-grid">
            @foreach (var prod in related)
            {
                <div class="related-card" onclick="window.location='@Url.Action("Detail", "Product", new { Id = prod.Id })'">
                    <div class="related-img">
                        @if (!string.IsNullOrEmpty(prod.ImageUrl))
                        {
                            <img src="@Url.Content("~/upload/product/" + @prod.ImageUrl)" alt="@prod.Name"
                                 style="width:100%;height:100%;object-fit:cover;" />
                        }
                        else
                        {
                            <div style="width:100%;height:100%;background:#e8e5e0;display:flex;align-items:center;justify-content:center;">
                                <div style="width:80px;height:140px;background:#c8c4bc;border-radius:40px;"></div>
                            </div>
                        }
                    </div>
                    <div class="related-info">
                        <p class="related-name">@prod.Name</p>
                        <p class="related-price">@prod.Price.ToString("#,0")₫</p>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        var selectedSize = '';
        var qty = 1;

        function selectSize(btn, size) {
            document.querySelectorAll('#sizeOptions .size-opt').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            selectedSize = size;
        }

        function changeQty(delta) {
            qty = Math.max(1, qty + delta);
            document.getElementById('qtyDisplay').value = qty;
        }

        function setMain(url) {
            document.getElementById('mainImage').src = url;
            document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
            event.currentTarget.classList.add('active');
        }

        function switchTab(btn, tabId) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        function handleAddToCart() {
            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'GET',
                data: {
                    Id: @Model?.Id,
                    Name: '@Html.Raw(Model?.Name?.Replace("'", "\\'"))',
                    Price: @Model?.Price,
                    quantity: qty,
                    Type: 1,
                    imageUrl: '@Model?.ImageUrl',
                    size: selectedSize
                },
                success: function (res) {
                    if (res === true) alert('Đã thêm vào giỏ hàng!');
                }
            });
        }

        function handleBuyNow() {           
            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'GET',
                data: {
                    Id: @Model?.Id,
                    Name: '@Html.Raw(Model?.Name?.Replace("'", "\\'"))',
                    Price: @Model?.Price,
                    quantity: qty,
                    Type: 1,
                    imageUrl: '@Model?.ImageUrl',
                    size: selectedSize
                },
                success: function () {
                    window.location = '@Url.Action("Index", "Checkout")';
                }
            });
        }
    </script>
}
