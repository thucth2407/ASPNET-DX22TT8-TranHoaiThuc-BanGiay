@model IEnumerable<ASPNET_DX22TT8_TranHoaiThuc_BanGiay.Models.ProductModel>
@{
    ViewData["Title"] = "Sản phẩm";
    var categories = ViewBag.Categories as IEnumerable<dynamic>;
    string currentCategory = ViewBag.CurrentCategory ?? "";
    string currentSearch = ViewBag.CurrentSearch ?? "";
    string currentSort = ViewBag.CurrentSort ?? "";
    int totalCount = Model?.Count() ?? 0;
}

<div class="breadcrumb">
    <a href="@Url.Action("Index", "Home")">Trang chủ</a>
    <span>›</span>
    <span style="color: var(--black)">Bộ sưu tập</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <p class="label">Bộ sưu tập</p>
        <h1 class="page-title">Tất cả <em>sản phẩm</em></h1>
        <p class="product-count">Hiển thị @totalCount sản phẩm</p>
    </div>
    <div class="page-header-right">
        <button class="filter-clear" onclick="clearFilters()">Xóa bộ lọc</button>
        <select class="sort-select" onchange="applySort(this.value)">
            @if (currentSort == "newest" || currentSort == "")
            {
                <option value="newest" selected>Mới nhất</option>
                <option value="price_asc">Giá: Thấp → Cao</option>
                <option value="price_desc">Giá: Cao → Thấp</option>
            }
            else if (currentSort == "price_asc")
            {
                <option value="newest">Mới nhất</option>
                <option value="price_asc" selected>Giá: Thấp → Cao</option>
                <option value="price_desc">Giá: Cao → Thấp</option>
            }
            else
            {
                <option value="newest">Mới nhất</option>
                <option value="price_asc">Giá: Thấp → Cao</option>
                <option value="price_desc" selected>Giá: Cao → Thấp</option>
            }
        </select>
        <div class="view-toggle">
            <button class="view-btn active" id="grid-btn" onclick="setView('grid')" title="Lưới">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
            </button>
            <button class="view-btn" id="list-btn" onclick="setView('list')" title="Danh sách">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <line x1="3" y1="6" x2="3.01" y2="6" />
                    <line x1="3" y1="12" x2="3.01" y2="12" />
                    <line x1="3" y1="18" x2="3.01" y2="18" />
                </svg>
            </button>
        </div>
    </div>
</div>

<div class="shop-layout">
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <!-- Danh mục động -->
        <div class="filter-section">
            <div class="filter-title">
                Danh mục
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </div>
            <div class="filter-option">
                <label>
                    <a href="@Url.Action("Index", "Product")"
                       style="text-decoration:none;color:inherit;@(currentCategory == "" ? "font-weight:600" : "")">
                        Tất cả
                    </a>
                </label>
            </div>
            @if (categories != null)
            {
                @foreach (var cat in categories)
                {
                    <div class="filter-option">
                        <label>
                            <a href="@Url.Action("Index", "Product", new { category = cat.Slug, search = currentSearch, sort = currentSort })"
                               style="text-decoration:none;color:inherit;@(currentCategory == (string)cat.Slug ? "font-weight:600" : "")">
                                @cat.Name
                            </a>
                        </label>
                        <span class="filter-count">@cat.Count</span>
                    </div>
                }
            }
        </div>
    </aside>

    <!-- PRODUCTS AREA -->
    <div class="products-area">
        <!-- Active filters -->
        @if (!string.IsNullOrEmpty(currentCategory) || !string.IsNullOrEmpty(currentSearch))
        {
            <div class="active-filters">
                <span style="font-size:12px;color:var(--muted);letter-spacing:0.05em;text-transform:uppercase;">Lọc:</span>
                @if (!string.IsNullOrEmpty(currentCategory))
                {
                    <span class="filter-tag">
                        @currentCategory
                        <button onclick="window.location='@Url.Action("Index", "Product", new { search = currentSearch, sort = currentSort })'">×</button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <span class="filter-tag">
                        "@currentSearch"
                        <button onclick="window.location='@Url.Action("Index", "Product", new { category = currentCategory, sort = currentSort })'">×</button>
                    </span>
                }
            </div>
        }

        <!-- Search box -->
        <div style="margin-bottom:20px;">
            <form method="get" action="@Url.Action("Index", "Product")" style="display:flex;gap:8px;">
                <input type="hidden" name="category" value="@currentCategory" />
                <input type="hidden" name="sort" value="@currentSort" />
                <input type="text" name="search" value="@currentSearch"
                       placeholder="Tìm kiếm sản phẩm..."
                       style="flex:1;padding:10px 16px;border:1px solid #e0ddd8;font-family:var(--sans);font-size:13px;" />
                <button type="submit"
                        style="padding:10px 20px;background:var(--black);color:var(--white);border:none;font-family:var(--sans);font-size:12px;letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;">
                    Tìm
                </button>
            </form>
        </div>

        <!-- Product grid -->
        <div class="product-grid" id="productGrid">
            @if (Model != null && Model.Any())
            {
                @foreach (var product in Model)
                {
                    <div class="product-card">
                        <div class="product-img">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@Url.Content("~/upload/product/" + @product.ImageUrl)" alt="@product.Name"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="product-img-bg">
                                    <div style="width:100px;height:160px;background:#c8c4bc;border-radius:60px 60px 20px 20px;"></div>
                                </div>
                            }                            
                            <div class="product-overlay">
                                <button class="overlay-btn"
                                        onclick="window.location='@Url.Action("Detail", "Product", new { Id = product.Id })'">
                                    Xem nhanh
                                </button>
                                <button class="overlay-btn"
                                        onclick="addToCart(@product.Id, '@product.Name.Replace("'", "\\'")', @product.Price, 1, 1, '@product.ImageUrl')">
                                    + Giỏ hàng
                                </button>
                            </div>
                        </div>
                        <div class="product-info">
                            <p class="product-tag">@(product.Category?.Name ?? "Sản phẩm")</p>
                            <p class="product-name">
                                <a href="@Url.Action("Detail", "Product", new { Id = product.Id })"
                                   style="text-decoration:none;color:inherit;">
                                    @product.Name
                                </a>
                            </p>
                            <p class="product-desc-short">@product.Description</p>
                            <div class="product-price">
                                <span class="price-current">@product.Price.ToString("#,0")₫</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="grid-column:1/-1;text-align:center;padding:60px 0;color:var(--muted);">
                    <p style="font-size:18px;margin-bottom:12px;">Không tìm thấy sản phẩm nào.</p>
                    <a href="@Url.Action("Index", "Product")" style="color:var(--black);font-size:13px;text-decoration:underline;">Xem tất cả sản phẩm</a>
                </div>
            }
        </div>
        <!-- end grid -->
    </div>
    <!-- end products-area -->
</div>

@section Scripts {
    <script>
        function applySort(value) {
            const url = new URL(window.location.href);
            url.searchParams.set('sort', value);
            window.location = url.toString();
        }

        function clearFilters() {
            window.location = '@Url.Action("Index", "Product")';
        }

        function setView(type) {
            const grid = document.getElementById('productGrid');
            const gridBtn = document.getElementById('grid-btn');
            const listBtn = document.getElementById('list-btn');
            if (type === 'list') {
                grid.classList.add('list-view');
                listBtn.classList.add('active');
                gridBtn.classList.remove('active');
            } else {
                grid.classList.remove('list-view');
                gridBtn.classList.add('active');
                listBtn.classList.remove('active');
            }
        }

        function addToCart(id, name, price, quantity, type, imageUrl) {
            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'GET',
                data: { Id: id, Name: name, Price: price, quantity: quantity, Type: type, imageUrl: imageUrl },
                success: function (res) {
                    if (res === true) alert('Đã thêm vào giỏ hàng!');
                }
            });
        }
    </script>
}
